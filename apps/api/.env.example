# Local development overrides for `pnpm dev:api`. Copy to `.env` (gitignored).
#
# None of this is required: src/main.ts defaults to a safe local setup —
# submissions are logged instead of stored or emailed, and reCAPTCHA is skipped.
# Deployed environments get their values from infra/lib/backend-stack.ts.

PORT=3001
SITE_NAME=Hidden Gem NC
PUBLIC_SITE_URL=http://localhost:8080

# Must match the header the Vite dev proxy injects (apps/web/vite.config.ts).
API_ORIGIN_SECRET=local-dev-origin-secret

# true = log the submission; nothing is written to DynamoDB and no email is sent.
CONTACT_DRY_RUN=true

# Accept submissions without a reCAPTCHA token. Local only — never set in AWS.
ALLOW_UNVERIFIED_SUBMISSIONS=true

# To exercise the real dev resources from your machine, set CONTACT_DRY_RUN=false
# and fill these in (sign in first with `aws sso login --profile ben-tce-root`):
# AWS_PROFILE=ben-tce-root
# AWS_REGION=us-east-1
# SUBMISSIONS_TABLE=hiddengem-contact-submissions-dev
# SES_FROM_ADDRESS=noreply@d.hiddengemnc.com
# CONTACT_ADMIN_EMAILS=you@example.com,colleague@example.com
