# Build-time settings for the web app. Copy to `.env.local` (gitignored) to override locally.
#
# Vite inlines every VITE_* variable into the public JavaScript bundle —
# never put a secret here. In CI these come from GitHub environment variables.

# Canonical origin used for canonical links, Open Graph URLs and the sitemap.
# VITE_SITE_URL=https://hiddengemnc.com

# local | dev | prod — anything but prod adds noindex and a disallow-all robots.txt.
# VITE_SITE_ENV=local

# reCAPTCHA v3 SITE key (public). Leave unset locally: the dev API skips verification.
# VITE_RECAPTCHA_SITE_KEY=

# GA4 measurement ID (public). Dev and prod each have their own GA4 property;
# analytics loads only when VITE_SITE_ENV is dev or prod, never locally.
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
