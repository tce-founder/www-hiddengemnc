{
  "name": "@hiddengem/infra",
  "version": "0.0.0",
  "private": true,
  "description": "AWS CDK app for hiddengemnc.com (dev + prod).",
  "scripts": {
    "cdk": "cdk",
    "synth": "cdk synth --quiet -c env=dev -o cdk.out/dev && cdk synth --quiet -c env=prod -o cdk.out/prod",
    "lint": "eslint bin lib test scripts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "aws-cdk-lib": "2.270.0",
    "constructs": "^10.8.1"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "aws-cdk": "2.1142.0",
    "eslint": "catalog:",
    "tsx": "^4.23.13",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
